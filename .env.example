# Same Supabase project as flashdeals.app.
# Use the Project URL (https://xxxx.supabase.co), not the postgres connection string.
# Use the publishable key (sb_publishable_...), never the secret key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Shared by all four Vercel shard projects; Vercel Cron sends Bearer CRON_SECRET
CRON_SECRET=generate-a-long-random-string
